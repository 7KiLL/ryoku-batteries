#!/usr/bin/env python3
"""WLMouse battery over hidraw, printed in headsetcontrol's JSON shape.

Read-only: sends only the GET-battery feature report the WL MOUSE HUB web driver
uses (64 bytes, no report ID): [2]=2 target mouse, [3]=2 len, [5]=0x83 GET battery.
Reply: [1]=0xA1 ok, [4]=2, [6]=0x83, [7]=charging, [8]=percent.
Needs the uaccess udev rule for VID 36a7 so the user can open /dev/hidraw*.
"""
import fcntl, glob, json, os, sys, time

VID, PIDS = 0x36A7, (0xA870, 0xA871)  # 2.4G receiver, wired


def ioc(nr, size):  # _IOC(_IOC_READ|_IOC_WRITE, 'H', nr, size)
    return (3 << 30) | (size << 16) | (ord('H') << 8) | nr


def find():
    """(hidraw node, product name) of the 64-byte vendor feature interface, or (None, None)."""
    for h in sorted(glob.glob('/sys/class/hidraw/hidraw*')):
        ue = open(h + '/device/uevent').read()
        if not any(f'HID_ID=0003:{VID:08X}:{p:08X}' in ue for p in PIDS):
            continue
        rd = open(h + '/device/report_descriptor', 'rb').read()
        if bytes.fromhex('9540b102') in rd and b'\x85' not in rd:
            name = next((l[9:] for l in ue.splitlines() if l.startswith('HID_NAME=')), 'WLMouse')
            return '/dev/' + os.path.basename(h), name
    return None, None


def parse(buf):
    """(charging, percent) from a HIDIOCGFEATURE reply, or None if not a valid battery answer."""
    if buf[1] == 0xA1 and buf[4] == 2 and buf[6] == 0x83 and buf[8] > 0:
        return bool(buf[7]), buf[8]
    return None


def query(dev, tries=10):
    cmd = bytearray(65)  # buf[0] = report ID 0, then the 64-byte payload
    cmd[3], cmd[4], cmd[6] = 2, 2, 0x83
    fd = os.open(dev, os.O_RDWR)
    try:
        for _ in range(tries):
            fcntl.ioctl(fd, ioc(0x06, 65), bytes(cmd))  # HIDIOCSFEATURE
            time.sleep(0.1)
            buf = bytearray(65)
            fcntl.ioctl(fd, ioc(0x07, 65), buf)  # HIDIOCGFEATURE
            r = parse(buf)
            if r:
                return r
            time.sleep(0.1)  # status < 0xA1 = busy, mouse hasn't answered yet
        return None
    finally:
        os.close(fd)


def main():
    dev, name = find()
    if not dev:
        return {"devices": []}
    d = {"device": "WLMouse", "product": name.replace(" RECEIVER", ""), "kind": "mouse",
         "battery": {"status": "BATTERY_UNAVAILABLE", "level": -1}}
    try:
        r = query(dev)
    except OSError as e:
        r, d["errors"] = None, {"battery": str(e)}
    if r:
        charging, pct = r
        d["battery"] = {"status": "BATTERY_CHARGING" if charging else "BATTERY_AVAILABLE", "level": pct}
    elif "errors" not in d:
        d["errors"] = {"battery": "No reply (mouse asleep or off?)"}
    return {"devices": [d]}


if __name__ == '__main__':
    if sys.argv[1:] == ['--test']:
        ok = bytearray(65); ok[1], ok[4], ok[6], ok[7], ok[8] = 0xA1, 2, 0x83, 1, 84
        assert parse(ok) == (True, 84)
        ok[8] = 0; assert parse(ok) is None          # 0% = unknown, as the hub treats it
        busy = bytearray(65); busy[1] = 0xA0; assert parse(busy) is None
        print('ok'); sys.exit()
    print(json.dumps(main()))
