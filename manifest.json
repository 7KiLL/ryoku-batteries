{
  "id": "headset",
  "name": "Batteries",
  "version": "0.2.0",
  "author": "l7kill <7killua@gmail.com>",
  "description": "Headset and WLMouse battery on the bar (headsetcontrol + hidraw).",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 320
  },
  "files": [
    "bin/wlmouse-battery"
  ],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Batteries"
  },
  "dependencies": {
    "commands": [
      "headsetcontrol",
      "python3"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "headset",
        "type": "toggle",
        "label": "Headsets (headsetcontrol)",
        "group": "Devices",
        "default": true
      },
      {
        "key": "wlmouse",
        "type": "toggle",
        "label": "WLMouse",
        "group": "Devices",
        "default": true
      },
      {
        "key": "showPercent",
        "type": "toggle",
        "label": "Show percentage",
        "group": "Headset",
        "default": true
      },
      {
        "key": "hideOffline",
        "type": "toggle",
        "label": "Hide when headset is off",
        "group": "Headset",
        "default": false
      },
      {
        "key": "lowPercent",
        "type": "int",
        "label": "Low battery warning (%)",
        "group": "Headset",
        "default": 15,
        "min": 5,
        "max": 50
      },
      {
        "key": "pollSec",
        "type": "int",
        "label": "Poll interval (seconds)",
        "group": "Headset",
        "default": 60,
        "min": 10,
        "max": 600
      }
    ]
  }
}
