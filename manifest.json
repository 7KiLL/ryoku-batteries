{
  "id": "batteries",
  "name": "Batteries",
  "version": "0.5.2",
  "author": "l7kill <7killua@gmail.com>",
  "description": "Peripheral batteries on the bar: UPower and headsetcontrol built in, plus your own reader commands from one JSON config.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 320
  },
  "files": [
    "bin/batteries",
    "bin/readers/headsetcontrol",
    "bin/readers/upower",
    "schema/readers.schema.json",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Batteries"
  },
  "dependencies": {
    "commands": [
      "python3",
      "upower",
      "headsetcontrol",
      "xdg-open"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "showPercent",
        "type": "toggle",
        "label": "Show percentage",
        "group": "Display",
        "default": true
      },
      {
        "key": "hideOffline",
        "type": "toggle",
        "label": "Hide devices that are off",
        "group": "Display",
        "default": false
      },
      {
        "key": "lowPercent",
        "type": "int",
        "label": "Low battery warning (%)",
        "group": "Display",
        "default": 15,
        "min": 5,
        "max": 50
      },
      {
        "key": "pollSec",
        "type": "int",
        "label": "Poll interval (seconds)",
        "group": "Display",
        "default": 60,
        "min": 10,
        "max": 600
      },
      {
        "key": "configPath",
        "type": "text",
        "label": "Readers config (JSON)",
        "group": "Readers",
        "default": "~/.config/ryoku-batteries/readers.json",
        "placeholder": "~/.config/ryoku-batteries/readers.json"
      }
    ]
  },
  "tags": [
    "battery",
    "headset",
    "mouse",
    "upower",
    "headsetcontrol",
    "bar-widget"
  ],
  "upstream": "https://github.com/7KiLL/ryoku-batteries"
}
